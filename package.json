{
  "name": "monstro",
  "productName": "Monstro",
  "version": "0.27.0",
  "description": "GitHub PRs para Mac, estilo Bitbucket. Merge commit siempre, squash jamás.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "doctor": "node scripts/doctor.js",
    "test": "node scripts/selftest-all.js",
    "test:unit": "npm run test:nodeps && node scripts/test-summary-block.js",
    "test:nodeps": "node scripts/test-health-verdict.js && node scripts/test-next-version.js && node scripts/test-release-notes.js && node scripts/test-sections-sync.js && node scripts/test-ipc-handlers.js && node src/version.js && node src/updater.js",
    "selftest": "electron . --selftest",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "Jesús García (JesusGR4)",
  "contributors": [
    "Javier Pallarés (JaviPalla)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JaviPalla/monstro"
  },
  "keywords": [
    "github",
    "pull-requests",
    "macos",
    "electron",
    "code-review",
    "git-graph"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.javipalla.monstro",
    "productName": "Monstro",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/icon-512.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "JaviPalla",
        "repo": "monstro"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
